{
  "name": "vit-academic-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 execute vit-academic-dashboard --local --file=schema.sql",
    "db:init": "wrangler d1 execute vit-academic-dashboard --remote --file=schema.sql",
    "deploy": "npm run zip:ext && wrangler deploy",
    "zip:ext": "cd extension && rm -f ../public/vit-dashboard-sync.zip && zip -qr ../public/vit-dashboard-sync.zip . -x '.*'"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "worker-mailer": "^1.3.1"
  }
}
